@bot.tree.command(name="setup", description="Richtet den Bot auf diesem Server ein")
async def setup(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        return await interaction.response.send_message("Nur Admins!", ephemeral=True)
    await interaction.response.defer(ephemeral=True)
    guild = interaction.guild
    for rank in RANKS:
        if not discord.utils.get(guild.roles, name=rank):
            await guild.create_role(name=rank)
    if not discord.utils.get(guild.text_channels, name="team-logs"):
        await guild.create_text_channel("team-logs")
    if not discord.utils.get(guild.text_channels, name="bewerbungen"):
        await guild.create_text_channel("bewerbungen")
    if not discord.utils.get(guild.text_channels, name="support"):
        await guild.create_text_channel("support")
    owner_role = discord.utils.get(guild.roles, name="Owner")
    if owner_role and owner_role not in guild.owner.roles:
        await guild.owner.add_roles(owner_role)
    await interaction.followup.send("SETUP FERTIG!")

@bot.tree.command(name="uprank", description="Befoerdert ein Teammitglied")
async def uprank(interaction: discord.Interaction, member: discord.Member, grund: str = "Gute Arbeit"):
    author_idx = get_rank_index(interaction.user)
    target_idx = get_rank_index(member)
    if author_idx == 999:
        return await interaction.response.send_message("Du bist kein Teammitglied!", ephemeral=True)
    if target_idx == 999:
        return await interaction.response.send_message("User ist nicht im Team! /team-add nutzen", ephemeral=True)
    if author_idx >= target_idx:
        return await interaction.response.send_message("Du kannst nur Leute UNTER dir befoerdern!", ephemeral=True)
    if target_idx == 0:
        return await interaction.response.send_message("Hoeher geht nicht mehr!", ephemeral=True)
    new_rank = RANKS[target_idx - 1]
    old_rank = RANKS[target_idx]
    old_role = discord.utils.get(interaction.guild.roles, name=old_rank)
    new_role = discord.utils.get(interaction.guild.roles, name=new_rank)
    if old_role: await member.remove_roles(old_role)
    if new_role: await member.add_roles(new_role)
    add_history(member.id, f"UPRANK: {old_rank} -> {new_rank} | Von: {interaction.user} | Grund: {grund}")
    await send_log(interaction.guild, "UP-RANK", f"{member.mention} befoerdert! Von: {old_rank} Zu: {new_rank} Von: {interaction.user.mention} Grund: {grund}", 0x00ff00)
    await interaction.response.send_message(f"{member.mention} befoerdert: {old_rank} -> {new_rank} | Grund: {grund}")

@bot.tree.command(name="downrank", description="Degradiert ein Teammitglied")
async def downrank(interaction: discord.Interaction, member: discord.Member, grund: str):
    author_idx = get_rank_index(interaction.user)
    target_idx = get_rank_index(member)
    if author_idx == 999 or author_idx >= target_idx:
        return await interaction.response.send_message("Darfst du nicht! Nur hoehere Raenge.", ephemeral=True)
    if target_idx == len(RANKS)-1:
        return await interaction.response.send_message("Niedriger geht nicht!", ephemeral=True)
    new_rank = RANKS[target_idx + 1]
    old_rank = RANKS[target_idx]
    old_role = discord.utils.get(interaction.guild.roles, name=old_rank)
    new_role = discord.utils.get(interaction.guild.roles, name=new_rank)
    if old_role: await member.remove_roles(old_role)
    if new_role: await member.add_roles(new_role)
    add_history(member.id, f"DOWNRANK: {old_rank} -> {new_rank} | Von: {interaction.user} | Grund: {grund}")
    await send_log(interaction.guild, "DOWN-RANK", f"{member.mention} degradiert! Von: {old_rank} Zu: {new_rank} Von: {interaction.user.mention} Grund: {grund}", 0xff0000)
    await interaction.response.send_message(f"{member.mention} degradiert: {old_rank} -> {new_rank} | Grund: {grund}")

