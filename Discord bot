@bot.tree.command(name="team-remove", description="Entfernt jemanden aus dem Team")
async def team_remove(interaction: discord.Interaction, member: discord.Member, grund: str):
    for rank in RANKS:
        role = discord.utils.get(interaction.guild.roles, name=rank)
        if role and role in member.roles:
            await member.remove_roles(role)
    if str(member.id) in db["team"]:
        del db["team"][str(member.id)]
    save()
    add_history(member.id, f"TEAM-LEAVE | Von: {interaction.user} | Grund: {grund}")
    await send_log(interaction.guild, "TEAM-LEAVE", f"{member.mention} aus Team entfernt! Grund: {grund}", 0xff0000)
